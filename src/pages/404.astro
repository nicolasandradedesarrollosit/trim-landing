---
import BaseLayout from '../layouts/BaseLayout.astro';
import Star from '../components/ui/Star.astro';
import { catalogUrl } from '../lib/content';
import { whatsappUrl } from '../lib/contact';
import { copy } from '../lib/copy';

const t = copy.pages.notFound;
---

<BaseLayout seo={{ title: t.seoTitle, description: t.description, noindex: true }}>
  <section class="wrap grid justify-items-start gap-6 pt-12 pb-[var(--space-section)]">
    <p class="label w-full border-b border-ink pb-3">{t.label}</p>
    <h1 class="display relative text-mega">
      {t.title}
      <Star class="absolute -top-6 -right-2 w-16 md:-right-14 md:w-20" edge />
    </h1>
    <p class="max-w-xl text-lg text-graphite">{t.body}</p>
    <div class="flex flex-wrap gap-3">
      <a class="btn" href={catalogUrl}>{t.ctaCatalog}</a>
      <a class="btn btn--ghost" href={whatsappUrl()} rel="noopener" target="_blank">{t.ctaWhatsapp}</a>
    </div>
  </section>
</BaseLayout>
