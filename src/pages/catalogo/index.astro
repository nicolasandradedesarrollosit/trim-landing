---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CatalogView from '../../components/catalog/CatalogView.astro';
import { catalogUrl, getProducts } from '../../lib/content';
import { copy } from '../../lib/copy';
import { breadcrumbLd, collectionLd, crumbs } from '../../lib/seo';

const products = await getProducts();
const { title, description, seoTitle, intro } = copy.catalog;
---

<BaseLayout
  seo={{ title: seoTitle, description }}
  jsonLd={[
    collectionLd({ name: title, description, path: catalogUrl, products }),
    breadcrumbLd(crumbs({ name: title, href: catalogUrl })),
  ]}
>
  <CatalogView all={products} products={products} title={title} intro={intro} />
</BaseLayout>
