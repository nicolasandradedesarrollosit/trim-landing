---
/**
 * The four-point star from the "R" of the logo, in chrome. The only non-monochrome
 * element of the identity. Decorative: always aria-hidden.
 */
interface Props {
  class?: string;
  /** Ellipse orbiting the star, echoing the oval of the badge logo. */
  orbit?: boolean;
  /** Slow rotation (disabled under prefers-reduced-motion). */
  spin?: boolean;
  /** Dark hairline around the star, for light backgrounds. */
  edge?: boolean;
}
const { class: className, orbit = false, spin = false, edge = false } = Astro.props;
// Gradient ids must be unique per instance in the page.
const id = `chrome-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  class:list={['star', { 'star--spin': spin }, className]}
  viewBox={orbit ? '-30 0 160 100' : '0 0 100 100'}
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id={id} x1="18" y1="10" x2="82" y2="92" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#ffffff"></stop>
      <stop offset=".26" stop-color="#b8bdc3"></stop>
      <stop offset=".44" stop-color="#555a61"></stop>
      <stop offset=".52" stop-color="#f4f6f8"></stop>
      <stop offset=".7" stop-color="#8b9198"></stop>
      <stop offset=".86" stop-color="#e3e6e9"></stop>
      <stop offset="1" stop-color="#6d737a"></stop>
    </linearGradient>
    <radialGradient id={`${id}-glint`} cx="44" cy="40" r="20" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#fff" stop-opacity=".95"></stop>
      <stop offset="1" stop-color="#fff" stop-opacity="0"></stop>
    </radialGradient>
  </defs>
  {
    orbit && (
      <ellipse cx="50" cy="50" rx="76" ry="17" fill="none" stroke={`url(#${id})`} stroke-width="2.2" transform="rotate(-14 50 50)" />
    )
  }
  <path
    class="star__body"
    d="M50 6C52 34 56 46 94 50 56 54 52 66 50 94 48 66 44 54 6 50 44 46 48 34 50 6Z"
    fill={`url(#${id})`}
    stroke={edge ? '#0b0b0c' : 'none'}
    stroke-width={edge ? 1 : 0}></path>
  <path d="M50 6C52 34 56 46 94 50 56 54 52 66 50 94 48 66 44 54 6 50 44 46 48 34 50 6Z" fill={`url(#${id}-glint)`}></path>
</svg>

<style>
  .star--spin .star__body,
  .star--spin path {
    transform-origin: 50px 50px;
    animation: star-spin 24s linear infinite;
  }
  @keyframes star-spin {
    to {
      rotate: 360deg;
    }
  }
</style>
