---
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import { NAV } from '../../config/site';
import { instagramHandle, instagramUrl, whatsappUrl } from '../../lib/contact';
import { copy } from '../../lib/copy';

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-ink bg-paper/95 backdrop-blur-sm">
  <div class="wrap flex h-14 items-center justify-between gap-6">
    <a href="/" class="text-ink" aria-label={copy.site.homeLabel}>
      <Logo variant="wordmark" class="w-[5.5rem]" label="" />
    </a>

    <nav aria-label={copy.nav.main} class="hidden md:block">
      <ul role="list" class="flex gap-7">
        {
          NAV.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={path.startsWith(l.href) ? 'page' : undefined}
                class="label link aria-[current]:underline"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={instagramUrl} class="btn btn--ghost hidden px-3 py-2 sm:inline-flex" rel="noopener" target="_blank">
        <Icon name="instagram" />
        <span class="hidden lg:inline">{instagramHandle}</span>
        <span class="sr-only">{copy.nav.instagram} ({copy.site.newTab})</span>
      </a>
      <a href={whatsappUrl()} class="btn px-3 py-2" rel="noopener" target="_blank">
        <Icon name="whatsapp" />
        <span>{copy.nav.whatsapp}</span>
      </a>

      <!-- Phones: CSS-only menu, no client JS. -->
      <details class="group relative md:hidden">
        <summary class="btn btn--ghost list-none px-3 py-2 [&::-webkit-details-marker]:hidden">
          <span class="group-open:hidden">{copy.nav.menu}</span><span class="hidden group-open:inline">{copy.nav.close}</span>
        </summary>
        <nav
          aria-label={copy.nav.main}
          class="absolute top-[calc(100%+0.6rem)] right-0 w-64 border border-ink bg-paper p-5 shadow-[6px_6px_0_var(--color-ink)]"
        >
          <ul role="list" class="grid gap-4">
            {
              NAV.map((l) => (
                <li>
                  <a href={l.href} class="display text-3xl no-underline">
                    {l.label}
                  </a>
                </li>
              ))
            }
            <li class="border-t border-rule pt-4">
              <a href={instagramUrl} class="label link" rel="noopener" target="_blank">
                {copy.nav.instagram} {instagramHandle}
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
