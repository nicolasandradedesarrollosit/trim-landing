---
/** Closing block: the two contact channels, as large as the page allows. */
import { Image } from 'astro:assets';
import Star from '../ui/Star.astro';
import Icon from '../ui/Icon.astro';
import photo from '../../assets/photos/puffers-walking.jpg';
import { instagramHandle, instagramUrl, whatsappUrl } from '../../lib/contact';
import { copy } from '../../lib/copy';

const t = copy.home.finalCta;
---

<section class="relative isolate overflow-hidden bg-ink text-paper" aria-labelledby="cta-title">
  <Image
    src={photo}
    alt=""
    width={1600}
    widths={[960, 1600]}
    sizes="100vw"
    class="photo-mono absolute inset-0 -z-10 size-full object-cover opacity-35"
  />
  <div class="wrap grid gap-10 py-[var(--space-section)]">
    <p class="label text-fog">{t.label}</p>
    <h2 id="cta-title" class="display relative text-mega leading-[0.8]" style="hyphens: auto">
      {t.title}
      <Star class="absolute top-[-0.15em] right-0 w-[0.5em] max-md:hidden" orbit spin />
    </h2>
    <div class="grid gap-3 sm:grid-cols-2 md:max-w-3xl">
      <a href={whatsappUrl()} class="btn btn--light justify-between py-5 text-sm" rel="noopener" target="_blank">
        <span class="flex items-center gap-2.5"><Icon name="whatsapp" /> {copy.nav.whatsapp}</span>
        <Icon name="arrow" />
      </a>
      <a href={instagramUrl} class="btn btn--light-ghost justify-between py-5 text-sm" rel="noopener" target="_blank">
        <span class="flex items-center gap-2.5"><Icon name="instagram" /> {instagramHandle}</span>
        <Icon name="arrow" />
      </a>
    </div>
    <p class="label text-fog">{copy.photos.finalCta.credit}</p>
  </div>
</section>
