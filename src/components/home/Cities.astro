---
/**
 * The stair-step block (reference: "HAUS® STUDIO" pin, see docs/DESIGN.md). Each column is
 * a city; its giant numeral is how many of our brands come from it, and the columns climb
 * from fewest to most. Everything is derived from BRANDS/CITIES in site.ts.
 */
import { BRANDS, CITIES } from '../../config/site';

const cities = CITIES.map((c) => ({ ...c, brands: BRANDS.filter((b) => b.city === c.code) }))
  .filter((c) => c.brands.length > 0)
  .sort((a, b) => a.brands.length - b.brands.length);
const max = Math.max(...cities.map((c) => c.brands.length));
const words = ['cero', 'una', 'dos', 'tres', 'cuatro', 'cinco', 'seis', 'siete', 'ocho', 'nueve', 'diez', 'once', 'doce'];
const say = (n: number) => words[n] ?? String(n);
---

<section class="block-ink section overflow-hidden" aria-labelledby="cities-title">
  <div class="wrap">
    <div class="opener border-rule-dark">
      <h2 id="cities-title" class="opener__title">
        {say(cities.length)} ciudades,<br />{say(BRANDS.length)} marcas
      </h2>
      <p class="label max-w-xs text-fog md:text-right">
        De dónde sale lo que vendemos. El número es cuántas marcas traemos de cada ciudad.
      </p>
    </div>

    <ol role="list" class="grid grid-cols-2 md:grid-cols-4">
      {
        cities.map((c) => (
          <li
            class="grid content-start gap-3 border-l border-rule-dark px-3 pb-2 first:border-l-0 md:px-5 max-md:[&:nth-child(3)]:border-l-0"
            style={`--step: ${max - c.brands.length}`}
          >
            <p class="label flex justify-between text-fog">
              <span>{c.code}</span>
              <span>{c.name}</span>
            </p>
            <p
              class="display md:mt-[calc(var(--step)*clamp(2.5rem,7vw,6.5rem))] text-[clamp(9rem,4rem+18vw,22rem)] leading-[0.78]"
              aria-label={`${c.brands.length} marcas`}
            >
              {c.brands.length}
            </p>
            <ul role="list" class="grid gap-1 border-t border-rule-dark pt-3 font-mono text-sm">
              {c.brands.map((b) => (
                <li>{b.name}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
