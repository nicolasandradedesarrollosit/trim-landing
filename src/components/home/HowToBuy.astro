---
/** The buying flow. Its steps are a real sequence, so they are numbered. */
import { Image } from 'astro:assets';
import photo from '../../assets/photos/street-smoke.jpg';
import { copy, fill } from '../../lib/copy';

const t = copy.home.howToBuy;
---

<section id="como-comprar" class="border-t border-ink" aria-labelledby="buy-title">
  <div class="wrap section grid gap-x-[var(--col-gap)] gap-y-12 md:grid-cols-12">
    <figure class="md:col-span-5">
      <Image
        src={photo}
        alt={copy.photos.howToBuy.alt}
        width={960}
        widths={[480, 720, 960]}
        sizes="(min-width: 48rem) 40vw, 92vw"
        class="photo-mono aspect-[4/5] w-full object-cover"
      />
      <figcaption class="label mt-2 text-steel">{copy.photos.howToBuy.credit}</figcaption>
    </figure>

    <div class="md:col-span-7 md:pl-[4%]">
      <h2 id="buy-title" class="display mb-10 text-giant whitespace-pre-line">{t.title}</h2>
      <ol role="list" class="grid">
        {
          t.steps.map((s, i) => (
            <li class="grid grid-cols-[4.5rem_1fr] gap-x-4 border-t border-ink py-6 md:grid-cols-[7rem_1fr]">
              <span class="display text-6xl md:text-8xl" aria-hidden="true">
                {i + 1}
              </span>
              <div class="grid content-start gap-2">
                <h3 class="display text-4xl">
                  <span class="sr-only">{fill(t.stepLabel, { n: i + 1 })}: </span>
                  {s.title}
                </h3>
                <p class="max-w-md text-graphite">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
