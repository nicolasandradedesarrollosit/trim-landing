---
/**
 * Live dollar rate + ARS prices. The HTML ships with no peso amounts: this component's
 * script fetches the rate on every visit and fills in every [data-usd] price. If the rate
 * cannot be read there is no fallback: the note and every price show an error, so no one
 * sees (or asks to buy at) a peso amount that may be wrong. Include it on every page that
 * shows ProductCards. Texts: `pricing` in copy.json.
 */
import { copy } from '../../lib/copy';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const t = copy.pricing;
---

<p
  class:list={['label data-[state=error]:font-bold data-[state=error]:text-ink', className]}
  data-rate
  data-state="loading"
  data-template={t.rate}
  data-error={t.error}
  data-unavailable={t.unavailable}
  aria-live="polite"
>
  {t.loading}
</p>
<noscript><p class:list={['label font-bold', className]}>{t.noscript}</p></noscript>

<script>
  import { fetchRate, formatArs, formatRateTime, toArs } from '../../lib/pricing';

  const notes = document.querySelectorAll<HTMLElement>('[data-rate]');
  const prices = document.querySelectorAll<HTMLElement>('[data-usd]');
  const first = notes[0]?.dataset;

  async function fillPrices() {
    try {
      const rate = await fetchRate();
      prices.forEach((el) => {
        el.textContent = formatArs(toArs(Number(el.dataset.usd), rate.venta));
      });
      notes.forEach((el) => {
        el.textContent = (el.dataset.template ?? '')
          .replace('{rate}', formatArs(rate.venta))
          .replace('{time}', formatRateTime(rate.updatedAt));
        el.dataset.state = 'ready';
      });
    } catch {
      // No fallback on purpose: a stale or guessed rate would show a wrong price.
      prices.forEach((el) => {
        el.textContent = first?.unavailable ?? '';
        el.dataset.state = 'error';
      });
      notes.forEach((el) => {
        el.textContent = el.dataset.error ?? '';
        el.dataset.state = 'error';
      });
    }
  }

  fillPrices();
</script>
